{
  "name": "project-folder-launcher",
  "version": "1.4.0",
  "description": "Barre de recherche rapide pour ouvrir les dossiers projets",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.js && node --test",
    "test": "node --test",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac dmg zip",
    "build:all": "electron-builder --win --mac",
    "release:win": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac dmg zip --publish never",
    "release:mac:updater": "electron-builder --mac dmg zip --publish never"
  },
  "keywords": [
    "electron",
    "project",
    "launcher",
    "windows",
    "macos"
  ],
  "author": "Lionel",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.balz.project-folder-launcher",
    "productName": "Project Folder Launcher",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.js",
    "asar": true,
    "electronLanguages": [
      "en",
      "fr"
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "LionelMds",
        "repo": "ProjectFolder",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "mini-search.html",
      "mini-renderer.js",
      "mini-search.css",
      "settings.html",
      "settings-renderer.js",
      "settings.css",
      "update.html",
      "update-renderer.js",
      "update.css",
      "src/main/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "artifactName": "ProjectFolderLauncher-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "dmg": {
      "title": "Project Folder Launcher",
      "artifactName": "ProjectFolderLauncher-${version}-${arch}-mac.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Folder Launcher",
      "runAfterFinish": true,
      "artifactName": "ProjectFolderLauncher-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "js-yaml": "5.2.1"
  }
}
